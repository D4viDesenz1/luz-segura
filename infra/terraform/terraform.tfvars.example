# Copie para terraform.tfvars (que está no .gitignore). NUNCA versione o .tfvars.
subscription_id  = "00000000-0000-0000-0000-000000000000"
imagem_container = "d4videsenz1/luz-segura:latest"

# Seu IP público: curl -s https://ifconfig.me  -> "x.x.x.x/32"
admin_cidr = "203.0.113.10/32"

# Gere cada um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
admin_token   = "<cole-aqui-o-valor-gerado>"
device_token  = "<cole-aqui-o-valor-gerado>"
metrics_token = "<cole-aqui-o-valor-gerado>"

# Opcional
# email_alerta_orcamento = "voce@exemplo.com"
# localizacao            = "eastus"
